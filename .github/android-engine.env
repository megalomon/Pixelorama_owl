# Configuration of the custom Godot Android engine build, shared by
# .github/workflows/android-engine.yml (builds it) and .github/workflows/android.yml (uses it).
# Any change to this file produces a new engine release tag (engine-<version>-<hash of this file>).

GODOT_VERSION=4.7.2
# Common instruction set of all CPU cores of the target devices (see devices_specs.md):
# Cortex-A55 + Cortex-A78 (Exynos 1380) and Oryon V2 (Snapdragon 8 Elite) all implement
# Armv8.2-A with the DotProd and RCpc extensions. Tuned for the Cortex-A78, the slower big core.
ENGINE_CCFLAGS=-march=armv8.2-a+dotprod+rcpc -mtune=cortex-a78
ENGINE_SCONS_ARGS=production=yes lto=full
